{
  "name": "@chgerkens/jira-time-tracker",
  "version": "1.0.0",
  "description": "Local Jira time tracker with proxy for Jira Server/Data Center (PAT auth)",
  "bin": {
    "jira-time-tracker": "server.js"
  },
  "files": [
    "server.js",
    "public/"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "pretest:ci": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit-node.xml \"test/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "coverage": "c8 npm run test:ci",
    "mutation": "stryker run"
  },
  "keywords": [
    "jira",
    "time-tracking",
    "worklog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chgerkens/jira-time-tracker.git"
  },
  "homepage": "https://github.com/chgerkens/jira-time-tracker#readme",
  "bugs": {
    "url": "https://github.com/chgerkens/jira-time-tracker/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "c8": "^12.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
